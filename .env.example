# Supabase > Connect > Session pooler. Codifique caracteres especiais da senha na URL.
DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA@POOLER_HOST:5432/postgres
# Opcional, caso sua conexão precise da CA do projeto:
# PG_CA_FILE=./prod-ca-2021.crt
PORT=3000
# Opcional. Crie a chave em https://aistudio.google.com/apikey, em um projeto Free Tier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
